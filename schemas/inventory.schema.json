{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/soyangdev-bit/ds-closed-loop/schemas/inventory.schema.json",
  "title": "DS closed-loop inventory",
  "description": "Frozen screen drop. Each components[] row maps a Magic Patterns React component to a UDX Angular selector. Magic Patterns never fills angular.*; those fields come from a UDX catalog dump (CSV or components.json) or stay todo placeholders.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "designSystem",
    "screenId",
    "referencePng",
    "frameSize",
    "components",
    "forbidden",
    "layoutChecks",
    "rubric"
  ],
  "properties": {
    "designSystem": {
      "type": "string",
      "const": "udx",
      "description": "Target Angular design system. Always \"udx\"."
    },
    "screenId": { "type": "string", "minLength": 1 },
    "referencePng": { "type": "string", "minLength": 1 },
    "frameSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "react", "angular", "required", "tokens"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "react": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "variant": { "type": "string" },
              "size": { "type": "string" }
            }
          },
          "angular": {
            "type": "object",
            "additionalProperties": true,
            "required": ["selector", "inputs"],
            "description": "UDX mapping. Filled from the UDX dump (selector + inputs/variants), never from Magic Patterns. Placeholder selectors use the udx-* prefix and the row's todo flag.",
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1,
                "description": "UDX Angular selector (e.g. udx-button). Placeholder until a catalog row maps this React component."
              },
              "inputs": {
                "type": "object",
                "additionalProperties": { "type": ["string", "number", "boolean"] }
              }
            }
          },
          "required": { "type": "boolean" },
          "todo": {
            "type": "boolean",
            "description": "True when angular.selector is a guessed udx-* placeholder, not a row from the UDX catalog dump. Gate A still scores required rows against that selector."
          },
          "tokens": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "forbidden": {
      "type": "array",
      "items": { "type": "string" }
    },
    "layoutChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["region"],
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "maxDriftPx": { "type": "number", "minimum": 0 }
        }
      }
    },
    "rubric": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
