{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/soyangdev-bit/ds-closed-loop/schemas/inventory.schema.json",
  "title": "DS closed-loop inventory",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "screenId",
    "referencePng",
    "frameSize",
    "components",
    "forbidden",
    "layoutChecks",
    "rubric"
  ],
  "properties": {
    "screenId": { "type": "string", "minLength": 1 },
    "referencePng": { "type": "string", "minLength": 1 },
    "frameSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "react", "angular", "required", "tokens"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "react": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "variant": { "type": "string" },
              "size": { "type": "string" }
            }
          },
          "angular": {
            "type": "object",
            "additionalProperties": true,
            "required": ["selector", "inputs"],
            "properties": {
              "selector": { "type": "string", "minLength": 1 },
              "inputs": {
                "type": "object",
                "additionalProperties": { "type": ["string", "number", "boolean"] }
              }
            }
          },
          "required": { "type": "boolean" },
          "tokens": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "forbidden": {
      "type": "array",
      "items": { "type": "string" }
    },
    "layoutChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["region"],
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "maxDriftPx": { "type": "number", "minimum": 0 }
        }
      }
    },
    "rubric": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
